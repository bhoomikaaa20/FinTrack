# Proxy API + receipts to Render so the browser sees them as same-origin.
# This keeps the session cookie first-party (third-party cookies are blocked
# by Safari, Brave, incognito, etc., which breaks sign-in).
/api/*       https://fintrack-cloud-1.onrender.com/api/:splat       200
/uploads/*   https://fintrack-cloud-1.onrender.com/uploads/:splat   200

# SPA fallback: let the client-side router handle every other path (must stay last)
/*           /index.html   200
